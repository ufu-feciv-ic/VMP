{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Configurar",
      "type": "shell",
      "command": "cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Compilar Tudo",
      "type": "shell",
      "command": "cmake --build build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Executar Testes",
      "type": "shell",
      "command": "${workspaceFolder}/build/vmp_tests.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "Compilar Tudo"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": true
      }
    },
    {
      "label": "Executar App",
      "type": "shell",
      "command": "${workspaceFolder}/build/vmp_app.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "Compilar Tudo"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
